{
  "name": "appfryer",
  "main": "expo-router/entry",
  "version": "1.0.15",
  "scripts": {
    "start": "watchman watch-del-all && expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "watchman watch-del-all && expo run:ios",
    "web": "watchman watch-del-all && expo start --web",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "build:ios": "mkdir -p builds; DATE=$(date '+%Y-%m-%d-%H-%M'); eas build -p ios --profile production --local --clear-cache --output ./builds/AppFryer-$DATE.ipa",
    "build:ios:preview": "mkdir -p builds; DATE=$(date '+%Y-%m-%d-%H-%M'); eas build -p ios --profile preview --local --clear-cache --output ./builds/AppFryer-$DATE-preview.ipa",
    "build:android": "mkdir -p builds; DATE=$(date '+%Y-%m-%d-%H-%M'); eas build -p android --profile production --local --clear-cache --output ./builds/AppFryer-$DATE.aab",
    "build:android:preview": "mkdir -p builds; DATE=$(date '+%Y-%m-%d-%H-%M'); eas build -p android --profile preview --local --clear-cache --output ./builds/AppFryer-$DATE-preview.apk"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@dev-plugins/react-query": "^0.0.7",
    "@expo/vector-icons": "^14.0.2",
    "@miblanchard/react-native-slider": "^2.6.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/native": "^6.0.2",
    "expo": "^51.0.0",
    "expo-apple-authentication": "~6.4.2",
    "expo-constants": "~16.0.2",
    "expo-dev-client": "~4.0.29",
    "expo-device": "~6.0.2",
    "expo-font": "~12.0.10",
    "expo-linear-gradient": "~13.0.2",
    "expo-linking": "~6.3.1",
    "expo-notifications": "~0.28.19",
    "expo-router": "~3.5.24",
    "expo-secure-store": "~13.0.2",
    "expo-splash-screen": "~0.27.7",
    "expo-status-bar": "~1.12.1",
    "expo-system-ui": "~3.0.7",
    "expo-updates": "~0.25.28",
    "expo-web-browser": "~13.0.3",
    "i18next": "^24.2.2",
    "i18next-http-backend": "^3.0.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-i18next": "^15.4.1",
    "react-native": "0.74.5",
    "react-native-circular-chart": "^1.0.9",
    "react-native-date-picker": "^5.0.8",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-image-picker": "^8.2.1",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-modal": "^13.0.1",
    "react-native-radial-slider": "^1.1.0",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-searchable-dropdown": "^1.1.3",
    "react-native-svg": "15.2.0",
    "react-native-video": "^6.8.2",
    "react-native-web": "~0.19.10",
    "react-native-worklets": "^0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.2.45",
    "@types/react-test-renderer": "^18.0.7",
    "@types/uuid": "^10.0.0",
    "axios": "^1.7.7",
    "expo-build-properties": "~0.12.5",
    "jest": "^29.2.1",
    "jest-expo": "~51.0.3",
    "react-test-renderer": "18.2.0",
    "typescript": "~5.3.3"
  },
  "private": true
}
